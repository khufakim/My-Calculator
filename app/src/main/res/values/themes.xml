<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyCalculator" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#2C2C2E</item>
        <item name="colorPrimaryDark">#1C1C1E</item>
        <item name="colorAccent">#FF9F0A</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <style name="CalcRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="CalcBtnBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalcBtnNum" parent="CalcBtnBase">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">24sp</item>
        <item name="android:background">@drawable/btn_num</item>
    </style>

    <style name="CalcBtnFunc" parent="CalcBtnBase">
        <item name="android:textColor">#FF9F0A</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/btn_func</item>
    </style>

    <style name="CalcBtnOp" parent="CalcBtnBase">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">28sp</item>
        <item name="android:background">@drawable/btn_op</item>
    </style>

    <style name="CalcBtnEq" parent="CalcBtnBase">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">28sp</item>
        <item name="android:background">@drawable/btn_eq</item>
    </style>

    <style name="CalcBtnClear" parent="CalcBtnBase">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">24sp</item>
        <item name="android:background">@drawable/btn_clear</item>
    </style>

</resources>